[Unit]
Description=CEO AI OS - Finance Web & Realtime Sheet Sync
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-os/products/ceo/web_finance
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 20130 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
